+
         result |= flatview_write_continue_step(attrs, buf, len, mr_addr, &l,
                                                mr);
+        openios_display_mmio_trace_mapped_access(access_addr,
+                                                  memory_region_name(mr),
+                                                  access_mr_addr,
+                                                  openios_display_mmio_trace_buffer_value(buf, l),
+                                                  l, true,
+                                                  "flatview");
 
         len -= l;
         buf += l;
@@ -3380,7 +3399,16 @@ MemTxResult flatview_read_continue(FlatView *fv, hwaddr addr,
 
     fuzz_dma_read_cb(addr, len, mr);
     for (;;) {
+        hwaddr access_addr = addr;
